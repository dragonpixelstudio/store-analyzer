# Analyzer
GEMINI_API_KEY=

# Durable store and rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Dodo Payments
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
# Optional. Use test_mode for Dodo test products/API key; omit or use live_mode for production.
DODO_PAYMENTS_ENVIRONMENT=live_mode
# Checkout stays closed until end-to-end sandbox testing and launch approval.
DODO_LIVE_PAYMENTS_ENABLED=false
# Canonical origin for CSRF checks and checkout return URLs.
APP_URL=https://launch.dragonpixelstudio.com
# Use a stable, separate random secret for wallets; do not rotate with webhook keys.
CREDIT_SESSION_SECRET=

# Dodo product IDs from Products > Product detail
DODO_PRODUCT_INDIE=
DODO_PRODUCT_PRO=
DODO_PRODUCT_QUICKFIX=
DODO_PRODUCT_TOPUP_25=
DODO_PRODUCT_TOPUP_100=
DODO_PRODUCT_TOPUP_250=

# Set to netlify only on Netlify Functions; leave unset for Vercel/local.
DPX_HOST_PROVIDER=

# Private worker dispatch authentication; independent from wallet credentials.
DPX_JOB_SECRET=
